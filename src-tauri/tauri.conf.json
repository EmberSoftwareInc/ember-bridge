{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember Bridge",
  "version": "0.5.0",
  "identifier": "app.ember.bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ember Bridge",
        "width": 1000,
        "height": 700,
        "minWidth": 780,
        "minHeight": 540,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:17831",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ember-bridge"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMzkyMUE5RUE3RkEwQzgKUldUSW9IL3FxU0U1WHdDN2FIVG9ycFNHRm5NYXFDTzVqMHpBMUNucm5sWnpvZXJqTXBDQW9nWU8K",
      "endpoints": [
        "https://github.com/EmberSoftwareInc/ember-bridge/releases/latest/download/latest.json"
      ]
    }
  }
}
